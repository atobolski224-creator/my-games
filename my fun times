<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Awesome Arcade</title>
    <style>
        body { font-family: sans-serif; background: #121212; color: #fff; text-align: center; margin: 0; padding: 20px; }
        h1 { color: #ff4757; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; max-width: 1000px; margin: 0 auto; padding: 20px; }
        .card { background: #1e1e1e; border: 2px solid #2f3542; border-radius: 10px; padding: 15px; cursor: pointer; transition: 0.2s; }
        .card:hover { transform: scale(1.05); background: #2f3542; }
        iframe { width: 100%; height: 600px; border: none; background: #000; display: none; margin-top: 20px; border-radius: 10px; }
        button.back { display: none; background: #ff4757; color: white; border: none; padding: 10px 20px; font-size: 16px; border-radius: 5px; cursor: pointer; margin-bottom: 20px; }
    </style>
</head>
<body>

    <h1>🎮 Free Arcade 🎮</h1>
    <p>Click a game to start playing instantly!</p>
    
    <button class="back" id="backBtn" onclick="closeGame()">⬅️ Back to Menu</button>
    <iframe id="gameFrame"></iframe>

    <div class="grid" id="menu">
        <!-- Add as many games as you want by copying the card lines below -->
        <div class="card" onclick="playGame('https://77b.io')"><h3>Slope</h3></div>
        <div class="card" onclick="playGame('https://77b.io')"><h3>Retro Bowl</h3></div>
        <div class="card" onclick="playGame('https://77b.io')"><h3>Crossy Road</h3></div>
        <div class="card" onclick="playGame('https://77b.io')"><h3>Cookie Clicker</h3></div>
        <div class="card" onclick="playGame('https://77b.io')"><h3>Geometry Dash</h3></div>
        <div class="card" onclick="playGame('https://77b.io')"><h3>Subway Surfers</h3></div>
    </div>

    <script>
        function playGame(url) {
            document.getElementById('menu').style.display = 'none';
            document.getElementById('backBtn').style.display = 'inline-block';
            const frame = document.getElementById('gameFrame');
            frame.src = url;
            frame.style.display = 'block';
        }
        function closeGame() {
            document.getElementById('menu').style.display = 'grid';
            document.getElementById('backBtn').style.display = 'none';
            const frame = document.getElementById('gameFrame');
            frame.style.display = 'none';
            frame.src = '';
        }
    </script>
</body>
</html>
