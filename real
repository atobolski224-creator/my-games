<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Retro Arcade Portal</title>
    <style>
        :root {
            --bg-color: #0d0e15;
            --sidebar-color: #161925;
            --accent-color: #ff3e6c;
            --text-color: #ffffff;
            --text-muted: #8a8f98;
            --card-color: #1f2335;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            user-select: none;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* Sidebar Navigation */
        .sidebar {
            width: 260px;
            background-color: var(--sidebar-color);
            border-right: 2px solid #23283d;
            display: flex;
            flex-direction: column;
            padding: 20px;
        }

        .logo {
            font-size: 22px;
            font-weight: 800;
            color: var(--accent-color);
            letter-spacing: 2px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .search-bar {
            width: 100%;
            padding: 10px 15px;
            background-color: #23283d;
            border: 1px solid #323954;
            border-radius: 8px;
            color: white;
            margin-bottom: 25px;
            outline: none;
        }

        .menu-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 10px;
            font-weight: 700;
        }

        .nav-links {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav-item {
            padding: 12px 15px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s ease;
            background: transparent;
            border: none;
            color: var(--text-color);
            text-align: left;
            width: 100%;
            font-size: 14px;
        }

        .nav-item:hover, .nav-item.active {
            background-color: var(--accent-color);
            color: white;
        }

        /* Main Content Dashboard */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 30px;
        }

        .view {
            display: none;
            width: 100%;
        }

        .view.active {
            display: block;
        }

        .section-title {
            font-size: 28px;
            font-weight: 800;
            margin-bottom: 20px;
        }

        /* Arcade Grid layout */
        .game-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
        }

        .game-card {
            background-color: var(--card-color);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #2a3047;
            cursor: pointer;
            transition: transform 0.2s, border-color 0.2s;
        }

        .game-card:hover {
            transform: translateY(-5px);
            border-color: var(--accent-color);
        }

        .game-thumb {
            width: 100%;
            height: 140px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            background: linear-gradient(135deg, #24293e, #161925);
        }

        .game-info {
            padding: 15px;
        }

        .game-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .game-tag {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* Canvas Game Console Stage */
        .stage-container {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            background-color: var(--card-color);
            border-radius: 16px;
            border: 2px solid #2a3047;
            padding: 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .stage-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .back-btn {
            background-color: #2a3047;
            border: none;
            color: white;
            padding: 8px 16px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }

        .back-btn:hover {
            background-color: #3b4363;
        }

        canvas {
            background-color: #000000;
            display: block;
            margin: 0 auto;
            border-radius: 8px;
            max-width: 100%;
            box-shadow: inset 0 0 20px rgba(255,255,255,0.1);
        }

        .controls-hint {
            margin-top: 15px;
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.5;
        }
    </style>
</head>
<body>

    <!-- Sidebar Menu Component -->
    <div class="sidebar">
        <div class="logo">🕹️ RETRO HUB</div>
        <input type="text" class="search-bar" placeholder="Search games...">
        
        <div class="menu-title">Discover</div>
        <ul class="nav-links">
            <li><button class="nav-item active" onclick="switchView('dashboard')">🏠 Dashboard</button></li>
            <li><button class="nav-item" onclick="launchGame('retro-bowl')">🏈 Retro Bowl Mini</button></li>
            <li><button class="nav-item" onclick="launchGame('super-bros')">🍄 Super Bros Run</button></li>
            <li><button class="nav-item" onclick="launchGame('brick-breaker')">🧱 Brick Breaker</button></li>
        </ul>
    </div>

    <!-- Main Dynamic Content Engine -->
    <div class="main-content">
        
        <!-- View 1: Catalog Dashboard -->
        <div id="dashboard-view" class="view active">
            <h1 class="section-title">Popular Games</h1>
            <div class="game-grid">
                <div class="game-card" onclick="launchGame('retro-bowl')">
                    <div class="game-thumb">🏈</div>
                    <div class="game-info">
                        <div class="game-title">Retro Bowl Mini</div>
                        <div class="game-tag">Sports / 8-Bit</div>
                    </div>
                </div>
                <div class="game-card" onclick="launchGame('super-bros')">
                    <div class="game-thumb">🍄</div>
                    <div class="game-info">
                        <div class="game-title">Super Bros Run</div>
                        <div class="game-tag">Action / Platformer</div>
                    </div>
                </div>
                <div class="game-card" onclick="launchGame('brick-breaker')">
                    <div class="game-thumb">🧱</div>
                    <div class="game-info">
                        <div class="game-title">Brick Breaker</div>
                        <div class="game-tag">Arcade / Classic</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- View 2: Active Arcade Machine Player Arena -->
        <div id="player-view" class="view">
            <div class="stage-container">
                <div class="stage-header">
                    <h2 id="active-game-title" class="game-title">Game Player</h2>
                    <button class="back-btn" onclick="exitGame()">✕ Close Game</button>
                </div>
                <canvas id="gameCanvas" width="700" height="400"></canvas>
                <div id="game-controls-text" class="controls-hint">Controls</div>
            </div>
        </div>

    </div>

    <!-- Embedded JavaScript Game Framework Mechanics -->
    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        
        let currentGameId = null;
        let animationFrameId = null;
        let gameLoopRunning = false;

        // Global Event Hooks & Trackers
        const keys = {};
        window.addEventListener('keydown', e => {
            keys[e.code] = true;
            if(["Space", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(e.code)) {
                e.preventDefault(); // Stop webpage from scrolling while gaming
            }
        });
        window.addEventListener('keyup', e => keys[e.code] = false);

        // Core View Layout Transitions
        function switchView(viewId) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
            
            if (viewId === 'dashboard') {
                document.getElementById('dashboard-view').classList.add('active');
                document.querySelector('.nav-item').classList.add('active');
                exitGame();
            }
        }

        function launchGame(gameId) {
            document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
            document.getElementById('player-view').classList.add('active');
            
            // Sync navigation highlights
            document.querySelectorAll('.nav-item').forEach(btn => {
                if(btn.getAttribute('onclick').includes(gameId)) btn.classList.add('active');
                else btn.classList.remove('active');
            });

